# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Configuration (MongoDB Atlas URI or local MongoDB URI)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/learnspace?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/learnspace

# JWT Authentication
JWT_SECRET=replace_with_a_strong_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google Gemini AI Configuration
# Obtain your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

